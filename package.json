{
  "name": "nplusm-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": "9.x"
  },
  "scripts": {
    "start": "node backend/server.js",
    "heroku-postbuild": "cd frontend && npm install && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start"
  },
  "dependencies": {
    "express": "^4.17.1",
    "pg": "^8.7.1",
    "dotenv": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.12",
    "concurrently": "^6.2.0"
  }
}